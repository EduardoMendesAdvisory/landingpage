# ──────────────────────────────────────────────────────────────
# Eduardo Mendes Advisory Platform — Environment Variables
# Copy this file to .env.local and fill in your values.
# IMPORTANT: SUPABASE_SERVICE_ROLE_KEY is server-only.
#            NEVER prefix it with NEXT_PUBLIC_.
# ──────────────────────────────────────────────────────────────

# Supabase — Project URL and public anon key (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase — Service Role Key (SERVER-ONLY — never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend — Email delivery (server-only)
RESEND_API_KEY=re_your_key_here
FROM_EMAIL=info@eduardomendes.com.au
RESEND_FROM_EMAIL=info@eduardomendes.com.au
RESEND_FROM_NAME=Eduardo Mendes Advisory

# Stripe — Payment processing (Sprint 04)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Calendly — Meeting scheduling
CALENDLY_API_KEY=your_calendly_personal_access_token
# Optional: required if webhook registration fails for solo accounts
# CALENDLY_ORGANIZATION_URI=https://api.calendly.com/organizations/XXXXXXXX
# Optional: signing key returned once when webhook is created via API
# CALENDLY_WEBHOOK_SIGNING_KEY=your_signing_key
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/eduardomendes-web/free-15-min-consultation
# Optional: paid consultation Calendly (shown after 3 free sessions)
NEXT_PUBLIC_PAID_CALENDLY_URL=https://calendly.com/eduardomendes-web/paid-consultation

# Advisor inbox for client portal messages
ADVISOR_EMAIL=info@eduardomendes.com.au

# Comma-separated emails allowed to sign in at /advisor/login (AdvisorHQ master panel)
# info@ is always allowed; add more addresses here if needed
MASTER_ADMIN_EMAILS=info@eduardomendes.com.au

# Default bank transfer instructions included on manual invoices (optional)
# INVOICE_PAYMENT_INSTRUCTIONS=Payment by EFT to...\nBSB: ...\nAccount: ...

# OpenAI — Builder quote analysis (server-only)
OPENAI_API_KEY=sk-your-key-here
# Optional: defaults to gpt-4o
# OPENAI_QUOTE_MODEL=gpt-4o

# App URL — Required for auth redirects and email links
# Local:  http://localhost:3000
# Production (Netlify): https://www.eduardomendes.com.au
NEXT_PUBLIC_SITE_URL=http://localhost:3000
