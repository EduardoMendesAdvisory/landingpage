# ──────────────────────────────────────────────────────────────
# Eduardo Mendes Advisory Platform — Environment Variables
# Copy this file to .env.local and fill in your values.
# IMPORTANT: SUPABASE_SERVICE_ROLE_KEY is server-only.
#            NEVER prefix it with NEXT_PUBLIC_.
# ──────────────────────────────────────────────────────────────

# Supabase — Project URL and public anon key (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase — Service Role Key (SERVER-ONLY — never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend — Email delivery API key (server-only)
RESEND_API_KEY=re_your_key_here

# Resend — Verified sending domain
RESEND_FROM_EMAIL=noreply@yourdomain.com.au
RESEND_FROM_NAME=Eduardo Mendes Advisory

# Stripe — Payment processing (Sprint 04)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Calendly — Meeting scheduling (Sprint 04)
CALENDLY_API_KEY=your_calendly_api_key
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/eduardomendes-web/free-15-min-consultation

# OpenAI — AI features (Phase 2 only — not in Sprints 1–4)
# OPENAI_API_KEY=sk-your-key-here

# App URL — Required for auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
